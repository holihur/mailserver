# 说明：绝大多数配置都可以在「管理后台」里改（邮件主机、SSL 证书、DKIM、服务商、用户等），
# 这里只需要保留启动必需项：数据库、JWT_SECRET，以及首次引导值。

PORT=8080
SMTP_PORT=2525
SUBMIT_PORT=587
# 465/995/993 隐式 TLS：默认开启监听；证书在管理后台配置后自动生效
SUBMIT_TLS_PORT=465
POP3_TLS_PORT=995
IMAP_TLS_PORT=993
POP3_PORT=110
IMAP_PORT=143

# ---- 数据库（PostgreSQL，必需）----
DATABASE_URL=postgres://mailserver:mailserver@db:5432/mailserver?sslmode=disable

# ---- 数据目录（zones.json、证书等，需持久化）----
DATA_DIR=/data

# ---- Redis（限流必需；缺失将拒绝启动）----
REDIS_URL=redis://redis:6379/0

# ---- 内置权威 DNS（与 API 同一进程/二进制；off 则禁用）----
DNS_ADDR=:53
# NS 记录主机名，如 ns1.example.com.（留空则用各 zone 的 ns1）
# NS_HOST=ns1.example.com.

# ---- 密钥（务必修改为随机 32 位以上）----
JWT_SECRET=change-me-to-32-chars-min

# ---- 证书 / ACME 缓存目录（手动证书与自动签发都会存这里，需持久化）----
CERT_DIR=/data/certs

# ---- 以下均为「可选引导值」，配好后建议改用管理后台修改 ----
# 本机邮件域名（greeting / Message-ID / MX 目标）
MAIL_HOST=mail.example.com
# 管理员邮箱（逗号分隔；不配则首个注册用户为管理员）
# ADMIN_EMAILS=admin@example.com,boss@example.com
# 兼容旧用法：证书文件路径（也可直接在后台手动上传/自动申请）
# TLS_CERT=/data/cert/fullchain.pem
# TLS_KEY=/data/cert/privkey.pem
# DKIM 私钥文件路径（也可在后台一键生成/导入）
# DKIM_KEY=/data/dkim.pem
DKIM_SELECTOR=dkim
# DKIM_DOMAIN 为空时从 MAIL_HOST 推导（mail.example.com -> example.com）
# DKIM_DOMAIN=example.com

# ---- 外发中继（可选，建议在管理后台填写）----
# SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
# SMTP_RELAY_USER=
# SMTP_RELAY_PASS=
SMTP_RELAY_FROM=noreply@example.com

# ---- 日志（写入文件并按大小滚动，同时输出 stdout）----
# LOG_FILE=/data/logs/mailserver.log   # 默认 DATA_DIR/logs/mailserver.log；off/-/stdout 可关闭文件输出
LOG_MAX_MB=50
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=1

# ---- 单封邮件大小上限（MB，入站/提交），默认 25 ----
MAX_MESSAGE_MB=25

# ---- DMARC 执行策略：none（仅标记，默认）| quarantine（隔离到垃圾箱）| reject（拒收）----
DMARC_ENFORCE=none

# ---- 发信节流（每用户）----
SEND_DAILY_LIMIT=500
SEND_PER_MINUTE=20

# ---- /metrics 鉴权（空=仅本机；设置后需 Authorization: Bearer）----
# METRICS_TOKEN=

# ---- MTA-STS 策略：none（默认，不提供）| testing | enforce ----
MTA_STS_MODE=none

# ---- 定时备份（BACKUP_DIR 为空则不启用）；BACKUP_HOOK 可用 $BACKUP_FILE 做异地 ----
# BACKUP_DIR=/data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# BACKUP_HOOK=rclone copy "$BACKUP_FILE" remote:mailserver-backups

# ---- DNSSEC 签名（密钥存 DATA_DIR/dnssec）----
DNSSEC_ENABLE=0
