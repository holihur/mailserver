PORT=8080
SMTP_PORT=2525
SUBMIT_PORT=587
# 465/995/993 隐式 TLS：配好证书后取消注释启用
# SUBMIT_TLS_PORT=465
# POP3_TLS_PORT=995
# IMAP_TLS_PORT=993
POP3_PORT=110
IMAP_PORT=143
# TLS 证书（Let's Encrypt 全链 + 私钥；为空则 587/110/143 明文）
# TLS_CERT=/data/cert/fullchain.pem
# TLS_KEY=/data/cert/privkey.pem
# 本机邮件域名（greeting / Message-ID 用）
MAIL_HOST=mail.example.com
# DKIM 自签名：私钥路径（openssl genrsa -out dkim.pem 2048），为空则不签名
# DKIM_KEY=/data/dkim.pem
DKIM_SELECTOR=dkim
# DKIM_DOMAIN 为空时从 MAIL_HOST 推导（mail.example.com -> example.com）
# DKIM_DOMAIN=example.com
JWT_SECRET=change-me-to-32-chars-min
# 管理后台：逗号分隔的管理员邮箱（命中自动提权；不配则首个注册用户为管理员）
# ADMIN_EMAILS=admin@example.com,boss@example.com
DB_PATH=./mail.db
# 25 出站被封时的外发中继（587+STARTTLS，如阿里云/腾讯云邮件推送、SendGrid 等）
# SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
# SMTP_RELAY_USER=
# SMTP_RELAY_PASS=
SMTP_RELAY_FROM=noreply@example.com
